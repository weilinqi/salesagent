# Copy to backend/.env and provide your own credentials. Never commit real .env.
ENVIRONMENT=development
PORT=8002
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MINIMAX_API_KEY=
MINIMAX_FALLBACK_API_KEY=
# Ignore local proxy settings by default; enable only when your network requires it.
MINIMAX_USE_PROXY=false
MINIMAX_GROUP_ID=
DEEPSEEK_API_KEY=
VOLC_API_KEY=
VOLC_API_SECRET=
VOLC_APP_ID=
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=salesagent
# Defaults to the project 原始数据 directory. In containers Compose sets /app/knowledge.
# KNOWLEDGE_DATA_DIR=C:/path/to/approved/knowledge
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
AUDIO_DEBUG_ENABLED=false
AUDIO_DEBUG_RETENTION_HOURS=24
ENABLE_MODEL_WARMUP=true
ENABLE_SCHEDULER=true
