# Copy to backend/.env and provide your own credentials. Never commit real .env.
ENVIRONMENT=development
PORT=8002
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# Defaults to the project 原始数据 directory. In containers Compose sets /app/knowledge.
# KNOWLEDGE_DATA_DIR=C:/path/to/approved/knowledge
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:8080","http://127.0.0.1:8080"]
AUDIO_DEBUG_ENABLED=false
AUDIO_DEBUG_RETENTION_HOURS=24
ENABLE_MODEL_WARMUP=true
ENABLE_SCHEDULER=true

# MiniMax search: defaults to existing MINIMAX_API_KEY; optionally use a separate search-enabled key.
MINIMAX_SEARCH_API_KEY=
# Mainland: https://api.minimaxi.com; global: https://api.minimax.io
MINIMAX_API_HOST=https://api.minimaxi.com

# Optional backup key; used only for eligible account/limit failures.
MINIMAX_FALLBACK_API_KEY=
# Optional third key, tried after the primary and backup credentials fail.
MINIMAX_TERTIARY_API_KEY=
MINIMAX_USE_PROXY=false
